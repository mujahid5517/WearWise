rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && request.resource.data.uid == uid;
      allow delete: if owns(uid);
    }

    match /wardrobe_items/{uid} {
      allow read, write: if owns(uid);
    }

    match /shopping_items/{uid} {
      allow read, write: if owns(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
